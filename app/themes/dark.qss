QWidget {{ background: {window_bg}; color: {text_primary}; font-family: "Microsoft YaHei UI"; font-size: 12px; }}
QLabel {{ background: transparent; }}
QMainWindow, QDialog {{ background: {window_bg}; }}
QMenuBar {{ background: {input_bg}; padding: 2px 8px; border: 0; }}
QMenuBar::item {{ padding: 6px 9px; background: transparent; border-radius: 4px; }}
QMenuBar::item:selected {{ background: {hover_bg}; }}
QMenu {{ background: {panel_bg}; border: 1px solid {border_strong}; border-radius: 5px; padding: 4px; }}
QMenu::item {{ padding: 7px 24px 7px 12px; border: 1px solid transparent; border-radius: 4px; }}
QMenu::item:selected {{ background: {hover_bg}; }}
QMenu[keyboardNavigation="true"]::item:selected {{ background: {selected_bg}; border: 1px solid {focus_ring}; }}
QMenu::item:disabled {{ color: {text_muted}; }}
QToolBar[role="commandbar"] {{ background: {workspace_chrome_bg}; border: 0; border-bottom: 1px solid {divider}; spacing: 4px; padding: 3px 6px; }}
QToolBar[role="commandbar"] QLabel {{ background: transparent; }}
QStatusBar {{ background: {input_bg}; border-top: 1px solid {divider}; color: {text_secondary}; min-height: 23px; }}
QStatusBar::item {{ border: 0; }}
QPushButton, QToolButton {{ background: {panel_secondary}; border: 1px solid {border}; border-radius: 4px; padding: 4px 8px; color: {text_primary}; min-height: 20px; }}
QPushButton:hover, QToolButton:hover {{ background: {hover_bg}; border-color: {border_strong}; }}
QPushButton:pressed, QToolButton:pressed {{ background: {pressed_bg}; border-color: {accent}; }}
QPushButton:disabled, QToolButton:disabled {{ color: {text_muted}; }}
QPushButton[variant="primary"], QToolButton[variant="primary"] {{ background: {accent}; color: {accent_text}; font-weight: 600; }}
QPushButton[variant="primary"]:hover, QToolButton[variant="primary"]:hover {{ background: {accent_hover}; }}
QPushButton[variant="primary"]:pressed, QToolButton[variant="primary"]:pressed {{ background: {accent_pressed}; }}
QPushButton[variant="secondary"] {{ background: {panel_secondary}; }}
QPushButton[variant="danger"] {{ color: {danger}; }}
QPushButton[menuOpen="true"] {{ background: {selected_bg}; border-color: {selected_border}; }}

QTabWidget::pane {{ border: 0; background: {panel_bg}; }}
QTabBar {{ background: {panel_bg}; }}
QTabBar::tab {{ background: transparent; color: {text_secondary}; border: 0; border-bottom: 2px solid transparent; padding: 6px 8px; min-height: 18px; }}
QTabBar::tab:hover {{ color: {text_primary}; background: {hover_bg}; }}
QTabBar::tab:selected {{ color: {text_primary}; border-bottom: 2px solid {accent}; font-weight: 600; }}
QListView, QListWidget, QTextEdit, QPlainTextEdit, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {{ background: {input_bg}; color: {text_primary}; border: 1px solid {border}; border-radius: 4px; selection-background-color: {selected_bg}; padding: 4px; }}
QListView, QListWidget {{ border: 0; background: {panel_bg}; outline: none; }}
QListView::item, QListWidget::item {{ padding: 3px; border: 1px solid transparent; }}
QListView::item:hover, QListWidget::item:hover {{ background: {hover_bg}; }}
QListView::item:selected, QListWidget::item:selected {{ background: {selected_bg}; border: 1px solid {selected_border}; color: {text_primary}; }}
QGraphicsView {{ border: 0; background: {canvas_bg}; }}
QSplitter::handle {{ background: {panel_bg}; border: 0; width: 7px; height: 7px; }}
QSplitter::handle:hover {{ background: {divider_strong}; }}
QScrollBar:vertical {{ background: transparent; width: 9px; margin: 0; }}
QScrollBar:horizontal {{ background: transparent; height: 9px; margin: 0; }}
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {{ background: {scrollbar_thumb}; border-radius: 4px; min-height: 24px; min-width: 24px; }}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {{ background: {scrollbar_hover}; }}
QScrollBar::add-line, QScrollBar::sub-line {{ width: 0; height: 0; }}
QScrollBar::add-page, QScrollBar::sub-page {{ background: transparent; }}
QProgressBar {{ background: {input_bg}; border: 0; border-radius: 3px; height: 6px; }}
QProgressBar::chunk {{ background: {accent}; border-radius: 3px; }}
QToolTip {{ background: {tooltip_bg}; color: {text_primary}; border: 1px solid {panel_border}; padding: 4px 6px; font-size: 12px; }}
QLabel[role="title"] {{ font-size: 20px; font-weight: 600; }}
QLabel[role="section"] {{ font-size: 13px; font-weight: 600; }}
QLabel[role="muted"] {{ color: {text_secondary}; font-size: 12px; }}
QLabel[role="badge"] {{ color: {success}; font-size: 12px; }}
QLabel[role="drop_title"] {{ font-size: 16px; font-weight: 600; }}
QWidget[role="panel"] {{ background: {panel_bg}; border: 0; }}
QWidget[role="rail"] {{ background: {workspace_chrome_bg}; border: 0; border-right: 1px solid {divider}; }}
QWidget[role="startup"] {{ background: {window_bg}; }}
QWidget[role="dropzone"] {{ background: {panel_bg}; border: 1px dashed {drop_border}; border-radius: 4px; }}
QWidget[role="dropzone"][dragActive="true"] {{ border: 2px dashed {accent}; background: {selected_bg}; }}

QScrollArea {{ border: 0; background: {panel_bg}; }}
QStatusBar QLabel, QStatusBar QToolButton {{ font-size: 11px; padding: 2px 6px; min-height: 16px; }}

QLineEdit:hover, QPlainTextEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {{ border: 1px solid {border_strong}; }}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {{ border: 1px solid {focus_ring}; }}
QPushButton[keyboardFocus="true"]:focus, QToolButton[keyboardFocus="true"]:focus {{ border: 1px solid {focus_ring}; }}

QComboBox {{ padding-right: 24px; }}
QComboBox::drop-down {{ width: 20px; border-left: 1px solid {border}; }}
QComboBox:on {{ border-color: {accent}; }}
QComboBox QAbstractItemView {{ background: {panel_bg}; border: 1px solid {border_strong}; selection-background-color: {selected_bg}; selection-color: {text_primary}; padding: 4px; }}
QTableWidget {{ outline: none; background: {panel_bg}; alternate-background-color: {panel_secondary}; gridline-color: {divider}; border: 1px solid {border}; selection-background-color: {selected_bg}; selection-color: {text_primary}; }}
QTableWidget::item {{ padding: 5px; border: 1px solid transparent; }}
QTableWidget::item:selected {{ border: 1px solid {selected_border}; background: {selected_bg}; }}
QTableWidget::item:hover {{ background: {hover_bg}; }}
QHeaderView::section {{ background: {panel_secondary}; color: {text_secondary}; border: 0; border-bottom: 1px solid {divider}; padding: 7px; }}
QLabel[error="true"] {{ color: {danger}; }}

QPushButton[keyboardFocus="true"]:focus:hover, QToolButton[keyboardFocus="true"]:focus:hover {{ border: 1px solid {focus_ring}; }}
QTableWidget::item:selected:hover {{ background: {selected_bg}; border: 1px solid {selected_border}; }}

QComboBox::down-arrow {{ image: url("{dropdown_arrow}"); width: 12px; height: 8px; }}

/* Workspace command and icon controls: idle flat; state is not a card. */
QToolButton[role="command"] {{ background: transparent; border: 0; padding: 0; min-height: 34px; }}
QToolButton[role="command"]::menu-button {{ width: 22px; border: 0; background: transparent; }}
QToolButton[role="command"]::menu-arrow {{ image: none; }}
QToolButton[role="icon"] {{ background: transparent; border: 1px solid transparent; padding: 0; min-height: 30px; min-width: 30px; }}
QToolButton[role="icon"]:hover {{ background: {hover_bg}; border-color: {panel_border}; }}
QToolButton[role="icon"]:pressed {{ background: {pressed_bg}; }}
QToolButton[role="icon"][keyboardFocus="true"]:focus {{ border-color: {focus_ring}; }}
QPushButton[role="tool"] {{ background: transparent; border: 0; padding: 0; min-height: 36px; min-width: 36px; }}
QPushButton[variant="ghost"] {{ background: transparent; border-color: transparent; }}
QPushButton[variant="ghost"]:hover {{ background: {hover_bg}; border-color: {panel_border}; }}
QPushButton[variant="ghost"]:pressed {{ background: {pressed_bg}; }}
QPushButton[variant="ghost"][keyboardFocus="true"]:focus {{ border-color: {focus_ring}; }}
QListView::item:selected:hover, QListWidget::item:selected:hover {{ background: {selected_bg}; border-color: {selected_border}; }}

QWidget[role="chromeSpacer"] {{ background: transparent; }}
QPushButton[role="recentOpen"] {{ text-align: left; background: transparent; border: 1px solid transparent; padding: 3px; }}
QPushButton[role="recentOpen"]:hover {{ background: {hover_bg}; border-color: {panel_border}; }}
QPushButton[role="recentOpen"][keyboardFocus="true"]:focus {{ border-color: {focus_ring}; }}
QLabel[role="stylePreview"] {{ background: {preview_bg}; color: {preview_ink}; border: 1px solid {panel_border}; border-radius: 4px; padding: 14px; }}
